  "description": "Build GCash deeplinks from EMV QR Ph (QRPH) payloads. Unofficial and unsupported.",
  "keywords": ["gcash", "qrph", "qr-ph", "emvco", "deeplink", "philippines", "instapay"],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
