# Identifiers sent with every deeplink. Neither is a secret in the
# cryptographic sense — both travel in plaintext in the URL — but neither is
# ours to publish, so they are configuration rather than committed constants.
#
# Copy to .env (which is gitignored) or export them in your shell.
# See docs/protocol.md "The two identifiers".

GCASH_CLIENT_ID=
GCASH_MERCHANT_ID=
